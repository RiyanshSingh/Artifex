{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile"
    },
    "web": {
      "root": "web",
      "framework": "sveltekit",
      "installCommand": "npm --prefix .. ci",
      "buildCommand": "npm --prefix .. run build -w web",
      "outputDirectory": "build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/files/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
